"use client";

import { useState } from "react";

type Message = {
  role: "user" | "assistant";
  text: string;
};

type TaskStep = {
  order: number;
  title: string;
  status: string;
};

export default function HomePage() {
  const [message, setMessage] = useState("");
  const [messages, setMessages] = useState<Message[]>([
    {
      role: "assistant",
      text: "Hi! I am your Manus-style AI agent. Tell me what you want done and I will plan the workflow.",
    },
  ]);
  const [plan, setPlan] = useState<TaskStep[]>([]);
  const [loading, setLoading] = useState(false);

  const handleSubmit = async (event: React.FormEvent) => {
    event.preventDefault();
    if (!message.trim()) return;

    const userMessage = message.trim();
    setMessages((current) => [...current, { role: "user", text: userMessage }]);
    setMessage("");
    setLoading(true);

    try {
      const apiUrl = process.env.NEXT_PUBLIC_API_URL || "http://localhost:8000";
      const response = await fetch(`${apiUrl}/api/chat`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ message: userMessage }),
      });

      if (!response.ok) {
        throw new Error("Failed to get a response from the backend");
      }

      const data = await response.json();
      setPlan(data.plan || []);
      setMessages((current) => [...current, { role: "assistant", text: data.answer }]);
    } catch (error) {
      setMessages((current) => [
        ...current,
        {
          role: "assistant",
          text: "The backend is unavailable. Please make sure the FastAPI server is running on port 8000.",
        },
      ]);
    } finally {
      setLoading(false);
    }
  };

  return (
    <main className="min-h-screen bg-slate-950 px-6 py-10 text-white">
      <div className="mx-auto max-w-7xl">
        <header className="mb-8 flex items-center justify-between border-b border-slate-800 pb-6">
          <div>
            <p className="text-sm uppercase tracking-[0.2em] text-brand-100">AI Agent</p>
            <h1 className="mt-2 text-3xl font-bold">Manus-style Workflow Console</h1>
          </div>
          <div className="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-4 py-2 text-sm text-emerald-300">
            MVP Ready
          </div>
        </header>

        <section className="mb-8 grid gap-4 md:grid-cols-3">
          <div className="rounded-2xl border border-slate-800 bg-slate-900 p-5 shadow-soft">
            <p className="text-sm text-slate-400">Planning</p>
            <h2 className="mt-2 text-2xl font-semibold text-white">Autonomous</h2>
          </div>
          <div className="rounded-2xl border border-slate-800 bg-slate-900 p-5 shadow-soft">
            <p className="text-sm text-slate-400">Execution</p>
            <h2 className="mt-2 text-2xl font-semibold text-white">Task Based</h2>
          </div>
          <div className="rounded-2xl border border-slate-800 bg-slate-900 p-5 shadow-soft">
            <p className="text-sm text-slate-400">Output</p>
            <h2 className="mt-2 text-2xl font-semibold text-white">Structured</h2>
          </div>
        </section>

        <div className="grid gap-8 lg:grid-cols-[1.4fr_0.8fr]">
          <section className="overflow-hidden rounded-3xl border border-slate-800 bg-slate-900">
            <div className="border-b border-slate-800 px-5 py-4">
              <h3 className="text-lg font-semibold">Conversation</h3>
            </div>

            <div className="space-y-4 p-5">
              {messages.map((msg, index) => (
                <div
                  key={`${msg.role}-${index}`}
                  className={`max-w-3xl rounded-2xl px-4 py-3 ${
                    msg.role === "assistant"
                      ? "bg-slate-800 text-slate-100"
                      : "ml-auto bg-brand-600 text-white"
                  }`}
                >
                  {msg.text}
                </div>
              ))}

              {loading && (
                <div className="max-w-3xl rounded-2xl bg-slate-800 px-4 py-3 text-slate-300">
                  Agent is thinking...
                </div>
              )}
            </div>

            <form onSubmit={handleSubmit} className="border-t border-slate-800 p-5">
              <div className="flex gap-3">
                <input
                  value={message}
                  onChange={(event) => setMessage(event.target.value)}
                  placeholder="Describe the task you want the AI agent to complete..."
                  className="flex-1 rounded-2xl border border-slate-700 bg-slate-950 px-4 py-3 text-sm text-white outline-none ring-0 transition focus:border-brand-500"
                />
                <button
                  type="submit"
                  disabled={loading}
                  className="rounded-2xl bg-brand-500 px-5 py-3 text-sm font-medium text-white transition hover:bg-brand-600 disabled:cursor-not-allowed disabled:opacity-60"
                >
                  {loading ? "Working..." : "Run Agent"}
                </button>
              </div>
            </form>
          </section>

          <aside className="space-y-6">
            <div className="rounded-3xl border border-slate-800 bg-slate-900 p-5">
              <h3 className="mb-4 text-lg font-semibold">Execution Plan</h3>

              {plan.length === 0 ? (
                <p className="text-sm text-slate-400">No task has been submitted yet.</p>
              ) : (
                <ul className="space-y-3">
                  {plan.map((step) => (
                    <li key={step.order} className="rounded-2xl border border-slate-800 bg-slate-950 p-3">
                      <div className="flex items-center justify-between gap-2">
                        <span className="text-sm font-medium">{step.order}. {step.title}</span>
                        <span
                          className={`rounded-full px-2 py-1 text-[10px] uppercase tracking-wide ${
                            step.status === "completed"
                              ? "bg-emerald-500/15 text-emerald-300"
                              : step.status === "in_progress"
                                ? "bg-amber-500/15 text-amber-300"
                                : "bg-slate-700 text-slate-300"
                          }`}
                        >
                          {step.status}
                        </span>
                      </div>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div className="rounded-3xl border border-slate-800 bg-slate-900 p-5">
              <h3 className="mb-4 text-lg font-semibold">Capabilities</h3>
              <ul className="space-y-2 text-sm text-slate-300">
                <li>• Research and information gathering</li>
                <li>• File and document handling</li>
                <li>• Browser automation</li>
                <li>• Code generation and execution</li>
                <li>• Structured reporting</li>
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </main>
  );
}
